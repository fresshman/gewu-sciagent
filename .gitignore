.venv/
__pycache__/
*.pyc
config/settings.yaml
data/raw/
data/large/
*.onnx
*.bin
model_links.txt
.DS_Store

# 前端（格物 Web）
web/node_modules/
web/dist/
*.log

# ── 环境变量与凭据（切勿提交） ──
.env
.env.*
!.env.example

# 私钥 / 证书 / 本地密钥文件
*.pem
*.key
*.p12
secrets/
credentials.json

# EasyScholar 期刊等级查询秘钥（本地私有，切勿提交；运行期由 journal_rank.py 读取）
gewu/mcp/.easyscholar_key

# 本地运行产物（可能含本机绝对路径）
gw.log
*.local.json

# IDE 本地配置（不纳入版本控制）
.idea/
.vscode/

# sci-plot 生成的插图（PDF 矢量 + PNG 预览），属运行产物不入版本库
output/figures/
# report「本地写 LaTeX」工具族落盘的文档/项目，属运行产物不入版本库
output/documents/
# 实测用的临时探针脚本与其中间产出（依赖本机路径与本机数据，不具可移植性）
output/scratch/

# ── 外部未发表项目的路径引用（本机私有，切勿提交） ──────────
# 格物通过路径引用读取未发表的 MIL+LIBS 煤热值项目（模型权重/实验数据原样留在
# 用户本机原始目录），仓库内绝不复制任何模型、数据或论文本体。
# 该文件只存一个绝对路径，便于本机运行；换机时重新写入即可。
.coal_project_root

# ── OpenClaw 运行时 / 本地身份与偏好文件 ──────────
# 这些是 OpenClaw 生成的工作区模板与运行时记忆：
# 占位模板无实际内容，USER.md 会存放用户偏好（属个人信息），
# 各 Agent 的 MEMORY.md 会在运行时被持续写入，均不应纳入版本控制。
SOUL.md
IDENTITY.md
USER.md
openclaw/workspace/agents/*/MEMORY.md

# ── Web 右栏真实案例数据（由 scripts/export_case_bundle.py 生成本机私有文件） ──
# 含未发表实验数值与本机路径，仅本机可读，绝不入库。
web/.local/

# ── sci-verify 反幻觉运行时缓存（本机私有，由核验服务落盘） ──
.aris/

# ── 原页理解（D4）运行产物：下载论文 PDF 与页面渲染图 ──────────
# 由 ideation 在检索核验时落盘，涉及文献版权且属本机运行缓存，不入版本库。
openclaw/workspace/agents/*/downloads/

# ── 领域项目路径引用锁（含本机私有绝对路径，切勿提交） ──────────
# 复现阶段锁定外部未发表项目的本机根目录，换机重新生成即可。
openclaw/workspace/agents/*/repro_lock.json
