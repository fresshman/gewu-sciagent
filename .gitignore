.venv/
__pycache__/
*.pyc
config/settings.yaml
data/raw/
data/large/
*.onnx
*.bin
model_links.txt
.DS_Store

# 前端（格物 Web）
web/node_modules/
web/dist/
*.log

# ── 环境变量与凭据（切勿提交） ──
.env
.env.*
!.env.example

# 私钥 / 证书 / 本地密钥文件
*.pem
*.key
*.p12
secrets/
credentials.json

# 本地运行产物（可能含本机绝对路径）
gw.log
*.local.json

# IDE 本地配置（不纳入版本控制）
.idea/
.vscode/

# sci-plot 生成的插图（PDF 矢量 + PNG 预览），属运行产物不入版本库
output/figures/
# report「本地写 LaTeX」工具族落盘的文档/项目，属运行产物不入版本库
output/documents/

# ── OpenClaw 运行时 / 本地身份与偏好文件 ──────────
# 这些是 OpenClaw 生成的工作区模板与运行时记忆：
# 占位模板无实际内容，USER.md 会存放用户偏好（属个人信息），
# 各 Agent 的 MEMORY.md 会在运行时被持续写入，均不应纳入版本控制。
SOUL.md
IDENTITY.md
USER.md
openclaw/workspace/agents/*/MEMORY.md
