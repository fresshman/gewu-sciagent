# 格物 (Gewu) — 环境变量示例
#
# 用法：
#   cp .env.example .env     # 然后填入真实值
#
# .env 已被 .gitignore 忽略，**永远不会进入 Git 仓库**。
# 本文件只提交占位示例，请勿在其中填写真实密钥。
#
# 下面列的是代码里**实际读取**的全部变量（web/proxy、web/shared、gewu/mcp、
# gewu/domain_packs）。除 INTERN_API_KEY 外都有可用默认值，不配也能跑；
# 每条注明默认值与"为什么是这个数"，需要改动时按注释调。

# ── 书生大模型 API Key（唯一必填项）──────────────────────
# openclaw/openclaw.json 中通过 ${INTERN_API_KEY} 引用该变量。
# 获取地址：https://internlm.intern-ai.org.cn/
# 注意：API 调用 baseUrl 为 https://chat.intern-ai.org.cn/api/v1
#      （令牌管理页所在的 internlm 域不能直接用于 API 调用）
#
# **只对网关进程 export 是不够的**（实测）：openclaw 给 stdio MCP 子进程的环境是
# 15 个键的白名单（PATH/TEMP/USERPROFILE/…），INTERN_API_KEY 不在里面，所以
# sci_data.parse_figure 会直接返回 status:"missing_key"。要让它进到子进程，
# 必须写进 MCP 服务自己的 env 块：
#   python scripts/bootstrap_openclaw_config.py --intern-api-key sk-xxx --write
# 该脚本会往生成配置的 mcp.servers.sci-data.env 里注入
#   INTERN_API_KEY: "sk-xxx"
# （不注入时留占位会报 warn；未解析的 ${VAR} 留在 env 里会让整个 sci-data 服务静默不启动。）
INTERN_API_KEY=sk-your-api-key-here

# ── OpenClaw 网关与 CLI ──────────────────────────────────
# 轻代理反代网关的地址。默认 http://127.0.0.1:18789（网关默认监听）。
#GATEWAY_URL=http://127.0.0.1:18789

# openclaw 可执行文件路径。默认从 PATH 解析（值为 openclaw）。
# 仅当 openclaw 不在 PATH、或需要用另一个 Node 版本跑它时才显式指定。
#OPENCLAW_BIN=openclaw

# openclaw 的入口 .mjs 绝对路径。用于"用指定 Node 版本启动 CLI"的场景：
# openclaw 要求 Node ≥24.16（且 <25）或 ≥26.1，而 Git Bash 默认 Node 常不满足，
# 此时用便携 Node 显式拉起：`<便携node> $OPENCLAW_MJS gateway run`。
#OPENCLAW_MJS=/path/to/node_modules/openclaw/openclaw.mjs

# 网关状态目录。默认 ~/.openclaw。
# 轻代理的「在飞计数」以**只读**方式打开 $OPENCLAW_HOME/agents/<agent>/agent/openclaw-agent.sqlite
# 里的 transcript_events 表，所以改了这个变量就等于换了计数的数据源，别指到别的实例。
#OPENCLAW_HOME=/c/Users/you/.openclaw

# ── Web 轻代理 ───────────────────────────────────────────
# 生产模式（cd web && npm start）监听端口，默认 3000；开发模式前端在 5173。
#PORT=3000

# 跑 openclaw 用的 Node。代理启动时会校验：不满足「≥24.16 且 <25 / ≥26.1」就拒绝启动
# （打印中文修法），因为版本不够时 openclaw 会 exit 1、界面上表现为「每句话都失败」。
# 不改 PATH 也能指过来：
#GEWU_NODE=/path/to/node-v26/bin/node

# 只跑静态前端、不做对话时的降级开关。开启后 /api/health 与页面红条仍标「未就绪」，
# /api/chat 直接返回未就绪原因，不假装能用。
#GEWU_ALLOW_DEGRADED_PROXY=1

# 单轮 Agent 任务的墙钟上限（秒），默认 3600。这是代理侧的兜底；
# 网关自身的上限是 openclaw.json 的 timeoutSeconds=1800，两者不要倒挂。
#GEWU_AGENT_TIMEOUT=3600

# 论文全文抽取的字符上限，默认 24000。超出的部分当前是**前缀硬截断**（后文丢弃），
# 长论文问后文内容会拿不到——按页选取是已知待办，暂时调大这个数可以缓解。
#GEWU_PAPER_MAX_CHARS=24000

# 论文抽取/问答的单次超时（秒），默认 300。
#GEWU_PAPER_TIMEOUT=300

# 划词与段落翻译的单次超时（秒），默认 120。
#GEWU_TRANSLATE_TIMEOUT=120

# 在飞轨迹轮询间隔（毫秒），默认 5000。调小更实时，代价是每 5s 打开一次只读 sqlite。
#GEWU_RUN_TRACE_POLL_MS=5000

# Web 右栏「真实案例」数据文件路径。默认 web/.local/case.json（已 gitignore，含未发表数值）。
# 缺失时 /api/case 返回 available:false + 生成提示，前端显示占位，**不会用假数据顶替**。
# 生成本机案例：python scripts/export_case_bundle.py
#GEWU_CASE_FILE=/path/to/case.json

# ── 长任务预算闸门（web/shared/run_budget.mjs）────────────
# 语义分两档，别混：**在飞越线 = exceeded（当场止损标记，不再续跑/不进下一阶段）；
# 收尾后才补上越线 = overrun（只记档，不改本轮终态、不回写 handoff）**。
# 工具维度阈值只能靠 transcript_events 在飞计数触发；实测 `sessions tail` 不流式且会少数
# （一轮真实 3 次调用，终态 burst 只报 2 行），所以不要拿 tail 行数当熔断依据。
#GEWU_RUN_BUDGET_WARN_TOOLS=20
#GEWU_RUN_BUDGET_TOOLS=30
#GEWU_RUN_BUDGET_WARN_MINUTES=18
#GEWU_RUN_BUDGET_MINUTES=25

# 「慢轮次」判定：距上一次轨迹事件超过该毫秒数就发 turn.slow 步骤，默认 120000。
# 参考实测耗时标尺：单条 MCP 工具轮 3–8s、一次模型推理 12–54s、整折 14 bag 真实 torch
# 复现 10.7s、七阶段单轮 12.6 分钟。
#GEWU_RUN_SLOW_GAP_MS=120000

# ── MCP 结果瘦身层（gewu/mcp/context_compactor.py）────────
# 大结果「摘要 + 原文落盘 + 可回取」。只处理超过上限的结果，小结果原样返回。
#GEWU_MCP_COMPACT=0             # 置 0 全局关闭（做对照实验时用）
#GEWU_MCP_COMPACT_LIMIT=3000    # 内联上限字符数
#GEWU_MCP_RAW_DIR=              # 原文落盘根目录，默认 ~/.gewu/mcp-raw（只允许读这个目录内的文件）

# ── 多模态读图（sci_data.parse_figure → InternVL3.5）──────
# 这四个变量在**每次调用时**读取，所以要改的是 MCP 子进程看到的环境：
# 写在 mcp.servers.sci-data.env 里（同 INTERN_API_KEY 的处理），只 export 到 shell 不生效。
# 实测读数与降级行为见 docs/verification/2026-11-04-parse-figure-vision.md。
#GEWU_VL_MODEL=internvl3.5-241b-a28b        # 读图模型 id（不是原页理解，那条走 sheng/intern-s2）
#GEWU_VL_BASE_URL=https://chat.intern-ai.org.cn/api/v1   # 必须是 chat. 域名；internlm. 域只放令牌页
#GEWU_VL_TIMEOUT_S=180                      # 单次读图墙钟上限；代码夹到 480s，必须留在 sci-data 的 600s 客户端闸门之下
#GEWU_VL_MAX_B64=600000                      # 图 base64 字符上限，超了返回 status:"too_large" 而不是硬发
                                             # 参考实测：48KB 谱图 → 64,560 字符；dpi=110 整页 → 358,700 字符

# ── 绘图与参考实现（coal_libs 领域包）─────────────────────
# 本地 sci-plot 与 PDF 渲染图的输出目录，默认 output/figures（已 gitignore，数据不出本机）。
#GEWU_FIG_DIR=output/figures

# 外部未发表煤项目根目录。模型权重与 LIBS 数据按赛题隐私要求**不入库**，
# 格物只按路径引用；未配置时 mil-model 工具返回 status:"not-configured"，不会编数。
#COAL_PROJECT_ROOT=/path/to/external-coal-project

# 跑外部推理用的 Python（需含 torch）。未指定时按候选路径探测，探测不到会在错误信息里
# 明确要求设置本变量。
#GEWU_COAL_PYTHON=/path/to/torch-env/bin/python

# ── 文献与期刊溯源（可选，缺失即降级）─────────────────────
# Semantic Scholar 图谱 API。不配则匿名访问（配额更低），代码内置节流。
#SEMANTIC_SCHOLAR_API_KEY=
# EasyScholar 期刊等级/分区查询密钥。取值顺序：本变量 → gitignored 的
# gewu/mcp/.easyscholar_key → ~/.openclaw/easyscholar.key；三者都没有则工具直接返回
# 明确错误（不静默给假等级）。官方限流每秒 2 次，代码内置 ~1.8 req/s 节流。
#EASYSCHOLAR_SECRET_KEY=
# CrossRef / arXiv 请求的 User-Agent 联系邮箱（反幻觉核验链对外署名）。
# 不配则用匿名占位地址；设成真实机构邮箱可**降低 CrossRef 限流风险**——
# 已跑出的测试跳过（test_verify_papers_fallback）正是限流/断网导致的，不是代码失败。
#ARIS_VERIFY_EMAIL=you@institution.edu
