// =============================================================
// 格物 (Gewu) — OpenClaw 配置（正确 schema，可合并进 ~/.openclaw/openclaw.json）
//
// 【重要·书生 API 的两个域，不要搞混】
//   1) 令牌管理 / 模型列表页（浏览器）: https://internlm.intern-ai.org.cn/api/document
//   2) API 调用 baseUrl（代码/OpenClaw）: https://chat.intern-ai.org.cn/api/v1
//  若误用 internlm.intern-ai.org.cn/api/v1 调用，会返回：
//  {"msgCode":"C1114","msg":"API token scope forbidden for this domain"}
//
// 【凭据】本模板用 ${INTERN_API_KEY} 占位，避免密钥进 Git。
//   本机已生效配置 ~/.openclaw/openclaw.json 内已写入真实 key；
//   换机部署时：设置环境变量 INTERN_API_KEY 或直接替换该值。
//
// 【Python 解释器路径】下方 mcp.servers[*].command 里的 Python 绝对路径是本机 WorkBuddy
//   托管 venv（<user> 为占位，需替换为你本机用户目录）；换机部署请指向你本机的 venv。
//   仓库内这些 .py 服务共用同一个 venv（本机叫 default），需同时满足：
//     mcp>=1,<2（FastMCP）+ numpy + pymupdf + pillow。缺 pymupdf 时 sci-data 的
//     pdf_page_map / render_pdf_pages 会直接报"PyMuPDF 不可用"，D4 原页理解链路断。
//   mil-model 不在此 venv 里装 torch，而是 subprocess 调用第三个 venv（含 torch，
//   见 GEWU_COAL_PYTHON / envs/coal-torch），避免把 torch 拖进全部服务。
//   paper-search 与 office-word 各自独立 venv（依赖与 mcp<2 冲突，不与上面合并）。
//
// OpenClaw 配置为 JSON5（支持注释与 ${ENV} 展开），Gateway 做严格 schema 校验
// （未知键会拒绝启动）。schema 以 `openclaw config validate` 为准。
// =============================================================

{
  // ---------- 1. 书生大模型（自定义 OpenAI 兼容 provider）----------
  // 模型引用格式 = provider/model，例如 "sheng/intern-s2"
  models: {
    mode: "merge",                 // merge=合并默认目录 | replace=仅用下方定义
    providers: {
      sheng: {
        baseUrl: "https://chat.intern-ai.org.cn/api/v1",   // ← 必须是 chat. 域
        apiKey: "${INTERN_API_KEY}",
        api: "openai-completions",  // 书生兼容 OpenAI Chat Completions
        models: [
          // 官方模型列表（2026-10 更新）。intern-s2 = 397B/256K，科学多模态推理
          // + 通用智能体 + 长程复杂任务，作为格物默认大脑。
          { id: "intern-s2",              name: "书生·Intern-S2 (397B/256K)",
            reasoning: false, input: ["text", "image"], contextWindow: 262144, maxTokens: 8192 },
          // 科学多模态推理，256K
          { id: "intern-s1-pro",          name: "书生·Intern-S1-Pro (科学多模态推理/256K)",
            reasoning: false, input: ["text", "image"], contextWindow: 262144, maxTokens: 8192 },
          // 轻量科学推理，32K（成本低，适合子智能体批量调用）
          { id: "intern-s1",              name: "书生·Intern-S1 (32K)",
            reasoning: false, input: ["text", "image"], contextWindow: 32768, maxTokens: 8192 },
          // 多模态视觉：谱图/曲线/分子式/论文版面理解
          { id: "internvl3.5-241b-a28b",  name: "书生·InternVL3.5-241B-A28B (多模态/32K)",
            reasoning: false, input: ["text", "image"], contextWindow: 32768, maxTokens: 8192 },
        ],
      },
    },
  },

  // ---------- 2. 智能体（OpenClaw 原生多智能体编排）----------
  // 注意：是 agents.entries（不是 agents.list），且需 ownership: "explicit"。
  // 角色铁律/分工写在工作区 AGENTS.md（OpenClaw 原生"员工手册"机制）。
  agents: {
    ownership: "explicit",
    defaults: {
      model: { primary: "sheng/intern-s2" },
      models: {
        "sheng/intern-s2":             { alias: "Intern-S2" },
        "sheng/intern-s1-pro":         { alias: "Intern-S1-Pro" },
        "sheng/intern-s1":             { alias: "Intern-S1" },
        "sheng/internvl3.5-241b-a28b": { alias: "InternVL3.5" },
      },
      workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace",
      // 默认 600s 不够：一轮科研闭环要串起检索→核验→原页理解→真实推理→绘图，
      // 大头是 intern-s2 自身的推理轮次，不是工具。
      // 【2026-10-29 实测纠正】旧注释写的"单步 MIL 复现就要 1~2 分钟"是误诊：那是
      // mil-model 的子进程继承了 MCP stdin 管道挂到 timeout。修复后整折 14 bag 真实
      // torch 复现 10.7s、cv_summary 0.2s。放宽到 30 分钟只为兜住多轮 LLM 推理。
      timeoutSeconds: 1800,
      modelPolicy: {
        allow: [
          "sheng/intern-s2",
          "sheng/intern-s1-pro",
          "sheng/intern-s1",
          "sheng/internvl3.5-241b-a28b",
        ],
      },
      // 7 阶段科研生命周期由 research_lifecycle Skill + Director 的 sessions_spawn 驱动。
    },
    entries: {
      "gewu-director":      { identity: { name: "格物·主编"   }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-director" },
      "gewu-ideation":      { identity: { name: "格物·探员"   }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-ideation" },
      "gewu-reproduction":  { identity: { name: "格物·复现员" }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-reproduction" },
      "gewu-improver":      { identity: { name: "格物·改进员" }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-improver" },
      "gewu-writer":        { identity: { name: "格物·写手"   }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-writer" },
      "gewu-publication":   { identity: { name: "格物·发表官" }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-publication" },
      "gewu-distillation":  { identity: { name: "格物·沉淀师" }, workspace: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/openclaw/workspace/agents/gewu-distillation" },
    },
  },

  // ---------- 3. MCP 工具层（Python Server，被 OpenClaw 经 MCP 调用）----------
  // 注意：是 mcp.servers（不是顶层 mcpServers）。工具命名 mcp__<server>__<tool>。
  // 解释器指向 managed venv（已装 mcp/numpy/sklearn/scipy）。
  mcp: {
    servers: {
      "sci-compute": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/sci_compute.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
      },
      "paper-search": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/paper-search/Scripts/python.exe",
        args: ["-m", "paper_search_mcp.server"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
      },
      // 请求超时（实测必需）：领域模型 5 折推理单次可达数十秒，绘图/PDF 解析也会跑满
      // 一个 CPU 核，OpenClaw 默认请求超时会在中途判 -32001 超时。重活服务单独放宽。
      "sci-data": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/sci_data.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 600000,
      },
      "mil-model": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/mil_model.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 900000,
        connectionTimeoutMs: 60000,
      },
      // 通用实验注册表（领域无关）：list/get/rerun/audit。领域包只需提供一份
      // registry/<domain>.json + 计算脚本即可接入（coverage example: coal-mil）。
      "sci-exp": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/sci_exp.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 1800000,
        connectionTimeoutMs: 60000,
      },
      // 反幻觉·文献核验服务（系统级第一公民）：把 verify_papers 的多层核验
      // （arXiv→CrossRef→S2→CrossRef标题→OpenAlex）暴露成 MCP 工具，7 个智能体
      // 任一均可直接调用，对检索到的参考文献做"存在性"反幻觉，阻断编造引用扩散。
      "sci-verify": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/verify_server.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 180000,
        connectionTimeoutMs: 60000,
      },
      "report": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/report.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 600000,
      },
      "sci-plot": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/default/Scripts/python.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/sci_plot.py"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
        requestTimeoutMs: 600000,
      },
      // chart-cloud：包装 @antv/mcp-server-chart，只暴露「不含实验数据」的结构/概念图。
      // 含数据的统计图一律走本地 sci-plot（数据不出本机）。换机需先 npm install -g @antv/mcp-server-chart。
      "chart-cloud": {
        command: "C:/Users/<user>/tools/node26/node-v26.9.0-win-x64/node.exe",
        args: ["F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent/gewu/mcp/chart_cloud.mjs"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
      },
      // office-word：本地生成/排版 Word 文档（python-docx，~70 工具），用于中文期刊/学位论文成稿。
      // 独立 venv（fastmcp 2.x，与 default 的 mcp<2 隔离）；-m 走 stdio 默认传输。
      // 换机部署：先建 venv 并 pip install 自 E:/UNpress/Office-Word-MCP-Server-main（或 PyPI office-word-mcp-server）。
      "office-word": {
        command: "C:/Users/<user>/.workbuddy/binaries/python/envs/office-word/Scripts/python.exe",
        args: ["-m", "word_document_server.main"],
        cwd: "F:/python-exercise/Industrial_LLM/langchain-learn/gewu-sciagent",
      },
    },
  },

  // ---------- 4. Gateway（本地模式）----------
  gateway: {
    mode: "local",
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },

  // ---------- 4.5 工具暴露方式（实测关键项）----------
  // toolSearch 把「大工具目录」藏在 search/describe/call 三步桥接后面，只把用到的 schema 放进 prompt。
  // 【2026-10-30 实测翻转：默认改为开】每轮 prompt 的固定开销 ≈95K–110K token，其中 83.6% 是
  // 266 个工具 schema（219,591 字符），与对话长度几乎无关。开启后同一份复现任务实测：
  // 每轮 estimatedPromptTokens 95,310 → 12,265、模型往返 13 → 6 轮、墙钟 285.0s → 158.5s，
  // 且 handoff 里 cached_metrics / cross_check / fold3 / failures 四个字段逐字一致（零产出损失）。
  // 代价：每个 MCP 工具要先 tool_describe 再 tool_call（一轮实测 20 次调用 / 10 轮），
  // 所以判效率要看轮次与墙钟，别拿「调用次数」当指标。
  // 【旧注释作废】这里原写「关，因为开启会让多步任务撞超时（首轮 27 次调用 / 14 turn 在 300s 被斩）」
  // —— 那次真因是 mil-model 的 subprocess 子进程继承了 MCP 的 stdin 管道而挂死（已修，见
  // docs/architecture.md §4.5 部署铁律 + tests/test_stdio_subprocess_guard.py），与 toolSearch 无关。
  // 改这个开关后必须树杀网关再起 `gateway run --force` 才生效。
  tools: {
    toolSearch: { mode: "tools" },
  },

  // ---------- 5. 渠道（本地演示可先不接；接微信/飞书/Slack 时在此配置）----------
  // channels: { wechat: { ... }, feishu: { ... } }
}
